+        cls.path = 'replica/Sources/Pasto/UI/ReplicaSearchIndex.swift'
+        cls.ui_path = 'replica/Sources/Pasto/UI/ReplicaUIController.swift'
+        cls.source = (ROOT / cls.path).read_text()
