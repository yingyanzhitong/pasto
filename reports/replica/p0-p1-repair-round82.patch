+        self.assertIn('return 0;',self.original('0x1000114fc'))
+        source=(ROOT/'replica/Sources/PastoCore/OriginalStackFunctions.swift').read_text()
+        self.assertIn('func f_1000114fc() -> Bool { false }',source)
