+import CoreData
+import Foundation
+
+/// A published object identity can outlive the source snapshot that supplied it.
+public struct ClipboardCollectionItemReference: Equatable {
+    private let context: NSManagedObjectContext
+    private let objectID: NSManagedObjectID
+
+    init(context: NSManagedObjectContext, objectID: NSManagedObjectID) {
+        self.context = context
+        self.objectID = objectID
+    }
+
+    public static func == (lhs: Self, rhs: Self) -> Bool {
+        lhs.context === rhs.context && lhs.objectID == rhs.objectID
+    }
+
+    // 3544dc: optional ID lookup, then the expected concrete entity class.
+    @MainActor public func item() -> ClipboardItem? {
+        guard let object = (try? context.existingObject(with: objectID)) as? PastoItemEntity else { return nil }
+        // Project the existing local representation only when the consumer asks for content.
+        return try? ClipboardPersistence.item(object)
+    }
+
+    // 35440c keeps a missing indexed element distinct from optional ID lookup.
+    @MainActor public func requiredItem() -> ClipboardItem {
+        guard let item = item() else { fatalError("Missing collection item") }
+        return item
+    }
+}
