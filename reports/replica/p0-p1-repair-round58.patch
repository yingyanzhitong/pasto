+    def test_unmatched_move_menu_actions_removed_but_drag_reorder_kept(self):
+        self.assertNotIn('state.movePinboard(', self.menu)
+        self.assertNotIn('func movePinboard(_ board: Pinboard, by offset: Int)', self.ui)
+        self.assertIn('state.movePinboard(id: id, before: board.id)', body(self.panel, 'private var boardTabs:'))
+        self.assertIn('func movePinboard(id: UUID, before target: UUID)', self.ui)
